{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "category", "summary", "takes", "gives", "icon", "needs", "targets"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "category": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "takes": { "type": "string", "minLength": 1, "maxLength": 80 },
    "gives": { "type": "string", "minLength": 1, "maxLength": 80 },
    "icon": { "enum": ["doc", "search", "mic", "mail", "chart", "shield", "table", "slides", "scale"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repo", "path", "license"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "connections", "secrets"],
      "properties": {
        "web": { "type": "boolean" },
        "connections": { "type": "array", "items": { "type": "string" } },
        "secrets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["workflows", "pulsar"] }
    }
  }
}
